<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Journal Entries</h1>

      <p>
        Review the accounting entries generated by
        sales, purchases, payments, returns and other
        financial activity.
      </p>
    </div>

    <div class="form-actions">
          <%= link_to(
          "New Manual Journal",
          new_accounting_journal_entry_path,
          class: "button button--primary"
        ) %>

<%= link_to "Chart of Accounts",
                  accounting_ledger_accounts_path,
                  class: "button button--secondary" %>
    </div>
  </header>

  <div class="panel">
    <%= form_with(
          url: accounting_journal_entries_path,
          method: :get,
          local: true
        ) do |form| %>

      <div class="filter-grid">
        <div class="field">
          <%= form.label :q,
                         "Search" %>

          <%= form.search_field(
                :q,
                value: @query,
                placeholder:
                  "Entry number, description or source"
              ) %>
        </div>

        <div class="field">
          <%= form.label :status,
                         "Status" %>

          <%= form.select(
                :status,
                [
                  ["All statuses", "all"],
                  ["Draft", "draft"],
                  ["Posted", "posted"],
                  ["Reversed", "reversed"]
                ],
                selected: @status
              ) %>
        </div>

        <div class="field">
          <%= form.label :from_date,
                         "From" %>

          <%= form.date_field(
                :from_date,
                value: @from_date
              ) %>
        </div>

        <div class="field">
          <%= form.label :to_date,
                         "To" %>

          <%= form.date_field(
                :to_date,
                value: @to_date
              ) %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Filter",
                        class: "button button--primary" %>

        <%= link_to "Clear",
                    accounting_journal_entries_path,
                    class: "button button--secondary" %>
      </div>
    <% end %>
  </div>

  <div class="panel">
    <% if @journal_entries.any? %>
      <table>
        <thead>
          <tr>
            <th>Entry</th>
            <th>Date</th>
            <th>Description</th>
            <th>Source</th>
            <th>Status</th>
            <th>Debit</th>
            <th>Credit</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @journal_entries.each do |entry| %>
            <tr>
              <td>
                <strong>
                  <%= entry.entry_number %>
                </strong>
              </td>

              <td>
                <%= entry.entry_date.strftime("%d %b %Y") %>
              </td>

              <td>
                <%= entry.description.presence || "—" %>
              </td>

              <td>
                <% if entry.source.present? %>
                  <%= entry.source_type.to_s
                        .underscore
                        .humanize %>
                  #<%= entry.source_id %>
                <% else %>
                  Manual
                <% end %>
              </td>

              <td>
                <%= entry.status.humanize %>
              </td>

              <td>
                <%= number_to_currency(
                      entry.total_debits,
                      unit: "KSh ",
                      precision: 2
                    ) %>
              </td>

              <td>
                <%= number_to_currency(
                      entry.total_credits,
                      unit: "KSh ",
                      precision: 2
                    ) %>
              </td>

              <td>
                <%= link_to "View",
                            accounting_journal_entry_path(
                              entry
                            ) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>
        No journal entries match these filters.
      </p>
    <% end %>
  </div>
</section>
