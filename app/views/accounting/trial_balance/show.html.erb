<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Trial Balance</h1>

      <p>
        Review ledger account balances and verify
        that total debits equal total credits.
      </p>
    </div>

    <div class="form-actions">
      <%= link_to(
            "Expenses",
            accounting_expenses_path,
            class: "button button--secondary"
          ) %>

      <%= link_to(
            "General Ledger",
            accounting_general_ledger_path,
            class: "button button--secondary"
          ) %>

      <%= link_to(
            "Journal Entries",
            accounting_journal_entries_path,
            class: "button button--secondary"
          ) %>

      <%= link_to(
            "Chart of Accounts",
            accounting_ledger_accounts_path,
            class: "button button--secondary"
          ) %>
    </div>
  </header>

  <div class="panel">
    <%= form_with(
          url: accounting_trial_balance_path,
          method: :get,
          local: true
        ) do |form| %>

      <div class="filter-grid">
        <div class="field">
          <%= form.label(
                :as_of_date,
                "As of date"
              ) %>

          <%= form.date_field(
                :as_of_date,
                value:
                  @as_of_date
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :branch_id,
                "Branch"
              ) %>

          <%= form.select(
                :branch_id,
                [
                  [
                    "All branches",
                    ""
                  ]
                ] +
                  @branches.map {
                    |branch|
                    [
                      branch.name,
                      branch.id
                    ]
                  },
                selected:
                  @branch&.id
              ) %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit(
              "Run Report",
              class: "button button--primary"
            ) %>

        <%= link_to(
              "Clear",
              accounting_trial_balance_path,
              class: "button button--secondary"
            ) %>
      </div>
    <% end %>
  </div>

  <% if @report_error.present? %>
    <div class="panel">
      <strong>
        Trial Balance could not be generated.
      </strong>

      <p>
        <%= @report_error %>
      </p>
    </div>

  <% elsif @trial_balance.present? %>
    <div class="panel">
      <dl class="details-list">
        <div>
          <dt>As of</dt>
          <dd>
            <%= @as_of_date
                  .strftime("%d %B %Y") %>
          </dd>
        </div>

        <div>
          <dt>Branch</dt>
          <dd>
            <%= @branch&.name ||
                  "All branches" %>
          </dd>
        </div>

        <div>
          <dt>Status</dt>
          <dd>
            <strong>
              <%= @trial_balance.balanced ?
                    "BALANCED" :
                    "OUT OF BALANCE" %>
            </strong>
          </dd>
        </div>
      </dl>
    </div>

    <div class="panel">
      <h2>Account Balances</h2>

      <% if @trial_balance.rows.any? %>
        <table>
          <thead>
            <tr>
              <th>Code</th>
              <th>Account</th>
              <th>Type</th>
              <th>Debit</th>
              <th>Credit</th>
            </tr>
          </thead>

          <tbody>
            <% @trial_balance.rows.each do |row| %>
              <tr>
                <td>
                  <strong>
                    <%= row.ledger_account.code %>
                  </strong>
                </td>

                <td>
                  <%= row.ledger_account.name %>
                </td>

                <td>
                  <%= row.ledger_account
                        .account_type
                        .humanize %>
                </td>

                <td>
                  <% if row.debit.positive? %>
                    <%= number_to_currency(
                          row.debit,
                          unit: "KSh ",
                          precision: 2
                        ) %>
                  <% else %>
                    —
                  <% end %>
                </td>

                <td>
                  <% if row.credit.positive? %>
                    <%= number_to_currency(
                          row.credit,
                          unit: "KSh ",
                          precision: 2
                        ) %>
                  <% else %>
                    —
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>

          <tfoot>
            <tr>
              <th colspan="3">
                TOTAL
              </th>

              <th>
                <%= number_to_currency(
                      @trial_balance.total_debits,
                      unit: "KSh ",
                      precision: 2
                    ) %>
              </th>

              <th>
                <%= number_to_currency(
                      @trial_balance.total_credits,
                      unit: "KSh ",
                      precision: 2
                    ) %>
              </th>
            </tr>
          </tfoot>
        </table>

        <p>
          <strong>
            <% if @trial_balance.balanced %>
              Trial balance is balanced.
            <% else %>
              Warning: trial balance is out of balance.
            <% end %>
          </strong>
        </p>

      <% else %>
        <p>
          No posted accounting balances were found
          for this date.
        </p>
      <% end %>
    </div>
  <% end %>
</section>
