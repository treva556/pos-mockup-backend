<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Record Expense</h1>

      <p>
        Record a business expense and automatically
        post it to accounting.
      </p>
    </div>

    <div class="form-actions">
      <%= link_to(
            "Back to Expenses",
            accounting_expenses_path,
            class: "button button--secondary"
          ) %>
    </div>
  </header>

  <div class="panel">
    <%= form_with(
          model: @expense,
          url: accounting_expenses_path,
          local: true
        ) do |form| %>

      <% if flash.now[:alert].present? %>
        <div class="form-errors">
          <p>
            <strong>
              <%= flash.now[:alert] %>
            </strong>
          </p>
        </div>
      <% end %>

      <% if @expense.errors.any? %>
        <div class="form-errors">
          <ul>
            <% @expense.errors.full_messages.each do |message| %>
              <li>
                <%= message %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="filter-grid">
        <div class="field">
          <%= form.label(
                :expense_date,
                "Date"
              ) %>

          <%= form.date_field(
                :expense_date,
                required: true
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :expense_account_id,
                "Expense Category"
              ) %>

          <%= form.collection_select(
                :expense_account_id,
                @expense_accounts,
                :id,
                :name,
                {
                  prompt:
                    "Select expense category"
                },
                required: true
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :money_account_id,
                "Paid From"
              ) %>

          <%= form.collection_select(
                :money_account_id,
                @money_accounts,
                :id,
                :name,
                {
                  prompt:
                    "Select money account"
                },
                required: true
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :branch_id,
                "Branch"
              ) %>

          <%= form.collection_select(
                :branch_id,
                @branches,
                :id,
                :name,
                {
                  include_blank:
                    "Use money account branch"
                }
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :amount,
                "Amount"
              ) %>

          <%= form.number_field(
                :amount,
                min: 0.01,
                step: 0.01,
                placeholder: "0.00",
                required: true
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :payee,
                "Payee"
              ) %>

          <%= form.text_field(
                :payee,
                placeholder:
                  "e.g. Landlord, KPLC"
              ) %>
        </div>

        <div class="field">
          <%= form.label(
                :reference,
                "Reference"
              ) %>

          <%= form.text_field(
                :reference,
                placeholder:
                  "Receipt or transaction reference"
              ) %>
        </div>
      </div>

      <div class="field">
        <%= form.label(
              :notes,
              "Notes"
            ) %>

        <%= form.text_area(
              :notes,
              rows: 4,
              placeholder:
                "Optional notes"
            ) %>
      </div>

      <div class="form-actions">
        <%= form.submit(
              "Record Expense",
              class: "button button--primary",
              data: {
                confirm:
                  "Record this expense?"
              }
            ) %>

        <%= link_to(
              "Cancel",
              accounting_expenses_path,
              class: "button button--secondary"
            ) %>
      </div>
    <% end %>
  </div>
</section>
