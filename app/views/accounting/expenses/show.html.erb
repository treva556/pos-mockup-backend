<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Expense Details</h1>

      <p>
        Review the recorded expense and its accounting status.
      </p>
    </div>

    <div class="form-actions">
      <%= link_to(
            "Back to Expenses",
            accounting_expenses_path,
            class: "button button--secondary"
          ) %>
    </div>
  </header>

  <div class="panel">
    <dl class="details-list">
      <div>
        <dt>Date</dt>
        <dd>
          <%= @expense.expense_date
                .strftime("%d %B %Y") %>
        </dd>
      </div>

      <div>
        <dt>Category</dt>
        <dd>
          <%= @expense.expense_account.name %>
        </dd>
      </div>

      <div>
        <dt>Amount</dt>
        <dd>
          <strong>
            <%= number_to_currency(
                  @expense.amount,
                  unit: "KSh ",
                  precision: 2
                ) %>
          </strong>
        </dd>
      </div>

      <div>
        <dt>Paid From</dt>
        <dd>
          <%= @expense.money_account.name %>
        </dd>
      </div>

      <div>
        <dt>Branch</dt>
        <dd>
          <%= @expense.branch&.name || "—" %>
        </dd>
      </div>

      <div>
        <dt>Payee</dt>
        <dd>
          <%= @expense.payee.presence || "—" %>
        </dd>
      </div>

      <div>
        <dt>Reference</dt>
        <dd>
          <%= @expense.reference.presence || "—" %>
        </dd>
      </div>

      <div>
        <dt>Status</dt>
        <dd>
          <strong>
            <%= @expense.status.upcase %>
          </strong>
        </dd>
      </div>

      <div>
        <dt>Recorded By</dt>
        <dd>
          <%= @expense.recorded_by.name %>
        </dd>
      </div>
    </dl>

    <% if @expense.notes.present? %>
      <hr>

      <h3>Notes</h3>

      <p>
        <%= @expense.notes %>
      </p>
    <% end %>
  </div>

  <% if @expense.journal_entry.present? %>
    <div class="panel">
      <h2>Accounting</h2>

      <p>
        Journal:
        <%= link_to(
              @expense.journal_entry.entry_number,
              accounting_journal_entry_path(
                @expense.journal_entry
              )
            ) %>
      </p>
    </div>
  <% end %>

  <% if @expense.status_posted? %>
    <div class="panel">
      <h2>Reverse Expense</h2>

      <p>
        Reversing creates the opposite accounting journal
        and restores the amount to the money account balance.
      </p>

      <%= form_with(
            url:
              reverse_accounting_expense_path(
                @expense
              ),
            method: :post,
            local: true
          ) do |form| %>

        <div class="field">
          <%= form.label(
                :reversal_date,
                "Reversal Date"
              ) %>

          <%= form.date_field(
                :reversal_date,
                value: Date.current,
                required: true
              ) %>
        </div>

        <%= form.submit(
              "Reverse Expense",
              class: "button button--secondary",
              data: {
                confirm:
                  "Reverse this expense?"
              }
            ) %>
      <% end %>
    </div>
  <% elsif @expense.status_reversed? %>
    <div class="panel">
      <strong>
        This expense was reversed
        <%= @expense.reversed_at
              .strftime("%d %b %Y %H:%M") %>.
      </strong>
    </div>
  <% end %>
</section>
