<header>
  <h1>Customers</h1>

  <%= link_to "New Customer", new_customer_path %>
</header>

<%= form_with url: customers_path,
              method: :get,
              local: true do |form| %>
  <%= form.search_field :q,
                        value: @query,
                        placeholder:
                          "Search name, phone, email or KRA PIN" %>

  <%= form.select :status,
                  [
                    [ "Active", "active" ],
                    [ "Inactive", "inactive" ],
                    [ "All", "all" ]
                  ],
                  selected: @status %>

  <%= form.submit "Search" %>

  <%= link_to "Clear", customers_path %>
<% end %>

<% if @customers.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>KRA PIN</th>
        <th>Credit limit</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td><%= link_to customer.name, customer %></td>
          <td><%= customer.phone.presence || "—" %></td>
          <td><%= customer.kra_pin.presence || "—" %></td>

          <td>
            <%= number_to_currency(
                  customer.credit_limit,
                  unit: "KSh ",
                  precision: 2
                ) %>
          </td>

          <td>
            <%= customer.active? ? "Active" : "Inactive" %>
          </td>

          <td>
            <%= link_to "Edit",
                        edit_customer_path(customer) %>

            <%= button_to(
                  customer.active? ? "Disable" : "Enable",
                  toggle_status_customer_path(customer),
                  method: :patch
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No customers found.</p>
<% end %>