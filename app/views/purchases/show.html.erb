<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Purchase Received</h1>

      <p>
        <strong>
          <%= @purchase.purchase_number %>
        </strong>
      </p>
    </div>

    <div class="form-actions">
      <% returnable =
           @purchase.purchase_lines.any? do |line|
             line.returnable_quantity.positive?
           end %>

      <% if returnable &&
            current_membership
              .purchase_return_management? %>
        <%= link_to "Return Items",
                    new_purchase_return_path(
                      @purchase
                    ),
                    class: "button button--primary" %>
      <% end %>

      <% if @purchase
              .effective_balance_due
              .positive? &&
            current_membership
              .supplier_payment_management? %>
        <%= link_to "Record Payment",
                    new_purchase_payment_path(
                      @purchase
                    ),
                    class: "button button--primary" %>
      <% end %>

      <%= link_to "Printable GRN",
                  receipt_purchase_path(@purchase),
                  target: "_blank",
                  rel: "noopener",
                  class: "button button--secondary" %>

      <% if current_membership.supplier_management? %>
        <%= link_to "Receive Another Purchase",
                    new_purchasing_purchase_path(
                      branch_id:
                        @purchase.branch_id
                    ),
                    class: "button button--secondary" %>
      <% end %>

      <% if current_membership
              .supplier_account_view? %>
        <%= link_to "Supplier Account",
                    supplier_account_path(
                      @purchase.supplier
                    ),
                    class: "button button--secondary" %>
      <% end %>

      <%= link_to "Dashboard",
                  dashboard_path,
                  class: "button button--secondary" %>
    </div>
  </header>

  <div class="panel">
    <h2>Purchase Information</h2>

    <dl class="details-list">
      <div>
        <dt>Purchase number</dt>
        <dd><%= @purchase.purchase_number %></dd>
      </div>

      <div>
        <dt>Supplier</dt>
        <dd><%= @purchase.supplier.name %></dd>
      </div>

      <div>
        <dt>Supplier invoice</dt>
        <dd>
          <%= @purchase
                .supplier_invoice_number
                .presence || "—" %>
        </dd>
      </div>

      <div>
        <dt>Branch</dt>
        <dd><%= @purchase.branch.name %></dd>
      </div>

      <div>
        <dt>Invoice date</dt>
        <dd>
          <%= @purchase
                .purchased_on
                .to_fs(:long) %>
        </dd>
      </div>

      <div>
        <dt>Payment due date</dt>
        <dd>
          <%= @purchase
                .due_on
                &.to_fs(:long) || "—" %>
        </dd>
      </div>

      <div>
        <dt>Recorded by</dt>
        <dd><%= @purchase.recorded_by.name %></dd>
      </div>

      <div>
        <dt>Original payment status</dt>
        <dd>
          <%= @purchase.payment_status.titleize %>
        </dd>
      </div>

      <div>
        <dt>Current supplier position</dt>
        <dd>
          <strong>
            <% if @purchase.overdue? %>
              Overdue
            <% elsif @purchase
                       .effective_balance_due
                       .positive? %>
              Outstanding
            <% elsif @purchase
                       .supplier_credit_due
                       .positive? %>
              Supplier credit
            <% else %>
              Settled
            <% end %>
          </strong>
        </dd>
      </div>
    </dl>
  </div>

  <div class="panel">
    <h2>Received Items</h2>

    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th>Quantity</th>
          <th>Returned</th>
          <th>Unit cost</th>
          <th>Discount</th>
          <th>Tax included</th>
          <th>Total</th>
        </tr>
      </thead>

      <tbody>
        <% @purchase
             .purchase_lines
             .ordered
             .each do |line| %>
          <tr>
            <td>
              <strong><%= line.item_name %></strong>
            </td>

            <td>
              <%= number_with_precision(
                    line.quantity,
                    precision: 4,
                    strip_insignificant_zeros: true
                  ) %>
              <%= line.unit_symbol %>
            </td>

            <td>
              <%= number_with_precision(
                    line.returned_quantity,
                    precision: 4,
                    strip_insignificant_zeros: true
                  ) %>
              <%= line.unit_symbol %>
            </td>

            <td>
              <%= number_to_currency(
                    line.unit_cost,
                    unit: "KSh "
                  ) %>
            </td>

            <td>
              <%= number_to_currency(
                    line.discount_amount,
                    unit: "KSh "
                  ) %>
            </td>

            <td>
              <%= number_to_currency(
                    line.tax_amount,
                    unit: "KSh "
                  ) %>
            </td>

            <td>
              <strong>
                <%= number_to_currency(
                      line.line_total,
                      unit: "KSh "
                    ) %>
              </strong>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h2>Original Purchase Totals</h2>

    <dl class="details-list">
      <div>
        <dt>Subtotal</dt>
        <dd>
          <%= number_to_currency(
                @purchase.subtotal,
                unit: "KSh "
              ) %>
        </dd>
      </div>

      <div>
        <dt>Discount</dt>
        <dd>
          <%= number_to_currency(
                @purchase.discount_total,
                unit: "KSh "
              ) %>
        </dd>
      </div>

      <div>
        <dt>Tax included</dt>
        <dd>
          <%= number_to_currency(
                @purchase.tax_total,
                unit: "KSh "
              ) %>
        </dd>
      </div>

      <div>
        <dt>Original purchase total</dt>
        <dd>
          <strong>
            <%= number_to_currency(
                  @purchase.total,
                  unit: "KSh "
                ) %>
          </strong>
        </dd>
      </div>

      <div>
        <dt>Amount paid</dt>
        <dd>
          <%= number_to_currency(
                @purchase.amount_paid,
                unit: "KSh "
              ) %>
        </dd>
      </div>

      <div>
        <dt>Original supplier balance</dt>
        <dd>
          <%= number_to_currency(
                @purchase.balance_due,
                unit: "KSh "
              ) %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="panel">
    <h2>Position After Returns</h2>

    <dl class="details-list">
      <div>
        <dt>Original supplier balance</dt>
        <dd>
          <%= number_to_currency(
                @purchase.balance_due,
                unit: "KSh "
              ) %>
        </dd>
      </div>

      <div>
        <dt>Completed purchase returns</dt>
        <dd>
          - <%= number_to_currency(
                 @purchase.completed_return_total,
                 unit: "KSh "
               ) %>
        </dd>
      </div>

      <div>
        <dt>Effective balance due</dt>
        <dd>
          <strong>
            <%= number_to_currency(
                  @purchase.effective_balance_due,
                  unit: "KSh "
                ) %>
          </strong>
        </dd>
      </div>

      <div>
        <dt>Excess return / supplier credit</dt>
        <dd>
          <strong>
            <%= number_to_currency(
                  @purchase.supplier_credit_due,
                  unit: "KSh "
                ) %>
          </strong>
        </dd>
      </div>
    </dl>

    <% if @purchase
            .effective_balance_due
            .positive? &&
          current_membership
            .supplier_payment_management? %>
      <div class="form-actions">
        <%= link_to "Record Supplier Payment",
                    new_purchase_payment_path(
                      @purchase
                    ),
                    class: "button button--primary" %>
      </div>
    <% end %>
  </div>

  <div class="panel">
    <h2>Purchase Returns</h2>

    <% completed_returns =
         @purchase
           .purchase_returns
           .select(&:completed?)
           .sort_by(&:returned_at)
           .reverse %>

    <% if completed_returns.any? %>
      <table>
        <thead>
          <tr>
            <th>Return</th>
            <th>Date</th>
            <th>Reason</th>
            <th>Total</th>
            <th>Debt reduced</th>
            <th>Credit due</th>
            <th>Credit recorded</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% completed_returns.each do |purchase_return| %>
            <tr>
              <td>
                <strong>
                  <%= purchase_return.return_number %>
                </strong>
              </td>

              <td>
                <%= purchase_return
                      .returned_at
                      .to_fs(:short) %>
              </td>

              <td>
                <%= purchase_return
                      .reason_code
                      .titleize %>
              </td>

              <td>
                <%= number_to_currency(
                      purchase_return.total,
                      unit: "KSh "
                    ) %>
              </td>

              <td>
                <%= number_to_currency(
                      purchase_return
                        .debt_offset_amount,
                      unit: "KSh "
                    ) %>
              </td>

              <td>
                <%= number_to_currency(
                      purchase_return
                        .supplier_credit_due,
                      unit: "KSh "
                    ) %>
              </td>

              <td>
                <%= number_to_currency(
                      purchase_return
                        .supplier_credit_total,
                      unit: "KSh "
                    ) %>
              </td>

              <td>
                <%= link_to "View",
                            purchase_return_path(
                              purchase_return
                            ) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>
        No goods have been returned against this
        purchase.
      </p>
    <% end %>
  </div>

  <div class="panel">
    <h2>Supplier Payment History</h2>

    <% if @purchase.purchase_payments.any? %>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Payment method</th>
            <th>Money account</th>
            <th>Reference</th>
            <th>Recorded by</th>
            <th>Amount</th>
          </tr>
        </thead>

        <tbody>
          <% @purchase
               .purchase_payments
               .recent_first
               .each do |payment| %>
            <tr>
              <td>
                <%= payment.paid_at.to_fs(:long) %>
              </td>

              <td>
                <%= payment.payment_method.name %>
              </td>

              <td>
                <%= payment.money_account.name %>
              </td>

              <td>
                <%= payment.reference.presence || "—" %>
              </td>

              <td>
                <%= payment.recorded_by.name %>
              </td>

              <td>
                <strong>
                  <%= number_to_currency(
                        payment.amount,
                        unit: "KSh "
                      ) %>
                </strong>
              </td>
            </tr>

            <% if payment.notes.present? %>
              <tr>
                <td colspan="6">
                  <strong>Notes:</strong>
                  <%= payment.notes %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>
        No supplier payments have been recorded for
        this purchase.
      </p>
    <% end %>
  </div>
</section>
