<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Money Transfer</h1>

      <p>
        Recorded on
        <%= @money_transfer.created_at.to_fs(:long) %>
      </p>
    </div>

    <div class="form-actions">
      <%= link_to "New Transfer",
                  new_money_transfer_path,
                  class:
                    "button button--primary" %>

      <%= link_to "Back to Transfers",
                  money_transfers_path,
                  class:
                    "button button--secondary" %>
    </div>
  </header>

  <div class="panel">
    <dl class="details-list">
      <div>
        <dt>From</dt>
        <dd>
          <%= @money_transfer.from_money_account.name %>
        </dd>
      </div>

      <div>
        <dt>To</dt>
        <dd>
          <%= @money_transfer.to_money_account.name %>
        </dd>
      </div>

      <div>
        <dt>Amount</dt>
        <dd>
          <%= number_to_currency(
                @money_transfer.amount,
                unit: "KSh ",
                precision: 2
              ) %>
        </dd>
      </div>

      <div>
        <dt>Transferred at</dt>
        <dd>
          <%= @money_transfer.transferred_at.to_fs(:long) %>
        </dd>
      </div>

      <div>
        <dt>Reference</dt>
        <dd>
          <%= @money_transfer.reference.presence ||
                "Not provided" %>
        </dd>
      </div>

      <div>
        <dt>Recorded by</dt>
        <dd>
          <%= @money_transfer.recorded_by.name %>
        </dd>
      </div>
    </dl>
  </div>

  <% if @money_transfer.notes.present? %>
    <div class="panel">
      <h2>Notes</h2>
      <%= simple_format(@money_transfer.notes) %>
    </div>
  <% end %>

  <div class="panel">
    <p>
      This is a transfer between business accounts.
      It is not recorded as income or an expense.
    </p>
  </div>
</section>