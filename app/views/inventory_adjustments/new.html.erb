<section class="page-section">
  <header class="page-header">
    <div>
      <h1>Opening Stock and Adjustments</h1>

      <p>
        Record opening quantities and authorised stock corrections.
      </p>
    </div>
  </header>

  <div class="panel">
    <%= form_with model: @adjustment,
                  url: inventory_adjustments_path,
                  scope: :inventory_adjustment,
                  class: "record-form" do |form| %>
      <% if @adjustment.errors.any? %>
        <section class="form-errors">
          <h2>
            <%= pluralize(
                  @adjustment.errors.count,
                  "error"
                ) %>
            prevented this movement from being recorded
          </h2>

          <ul>
            <% @adjustment.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <div class="form-grid">
        <div class="field">
          <%= form.label :branch_id, "Branch" %>

          <%= form.collection_select(
                :branch_id,
                @branches,
                :id,
                :name,
                {
                  prompt: "Select a branch"
                },
                {
                  required: true
                }
              ) %>
        </div>

        <div class="field">
          <%= form.label :item_id, "Product" %>

          <%= form.collection_select(
                :item_id,
                @items,
                :id,
                ->(item) {
                  "#{item.name} (#{item.unit_of_measure.symbol})"
                },
                {
                  prompt: "Select a product"
                },
                {
                  required: true
                }
              ) %>
        </div>

        <div class="field">
          <%= form.label :movement_type,
                         "Movement type" %>

          <%= form.select :movement_type,
                          [
                            ["Opening stock", "opening"],
                            ["Adjustment in", "adjustment_in"],
                            ["Adjustment out", "adjustment_out"]
                          ] %>
        </div>

        <div class="field">
          <%= form.label :quantity %>

          <%= form.number_field :quantity,
                                min: 0.0001,
                                step: 0.0001,
                                required: true %>

          <small class="field-help">
            Enter a positive quantity. Adjustment out will
            automatically reduce stock.
          </small>
        </div>

        <div class="field">
          <%= form.label :occurred_at,
                         "Date and time" %>

          <%= form.datetime_local_field(
                :occurred_at,
                required: true
              ) %>
        </div>

        <div class="field">
          <%= form.label :reference %>

          <%= form.text_field :reference,
                              placeholder:
                                "Stock count or document reference" %>
        </div>

        <div class="field field--full">
          <%= form.label :notes,
                         "Reason or notes" %>

          <%= form.text_area :notes,
                             rows: 4,
                             placeholder:
                               "Explain why this adjustment is required" %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Record Stock Movement",
                        class: "button button--primary" %>

        <%= link_to "Dashboard",
                    dashboard_path,
                    class: "button button--secondary" %>
      </div>
    <% end %>
  </div>

  <div class="panel">
    <h2>Movement guidance</h2>

    <dl class="details-list">
      <div>
        <dt>Opening stock</dt>
        <dd>
          The quantity available when the business starts
          using the POS. It can only be entered once.
        </dd>
      </div>

      <div>
        <dt>Adjustment in</dt>
        <dd>
          Adds stock found during a count or correction.
        </dd>
      </div>

      <div>
        <dt>Adjustment out</dt>
        <dd>
          Removes damaged, missing or incorrectly recorded stock.
        </dd>
      </div>
    </dl>
  </div>
</section>