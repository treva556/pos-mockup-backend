<header>
  <h1>Suppliers</h1>

  <%= link_to "New Supplier",
              new_supplier_path %>
</header>

<%= form_with url: suppliers_path,
              method: :get,
              local: true do |form| %>
  <%= form.search_field(
        :q,
        value: @query,
        placeholder:
          "Search name, phone, email or KRA PIN"
      ) %>

  <%= form.select(
        :status,
        [
          ["Active", "active"],
          ["Inactive", "inactive"],
          ["All", "all"]
        ],
        selected: @status
      ) %>

  <%= form.submit "Search" %>

  <%= link_to "Clear",
              suppliers_path %>
<% end %>

<% if @suppliers.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>KRA PIN</th>
        <th>Contact person</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @suppliers.each do |supplier| %>
        <tr>
          <td>
            <%= link_to supplier.name,
                        supplier_path(supplier) %>
          </td>

          <td>
            <%= supplier.phone.presence || "—" %>
          </td>

          <td>
            <%= supplier.kra_pin.presence || "—" %>
          </td>

          <td>
            <%= supplier.contact_person.presence || "—" %>
          </td>

          <td>
            <%= supplier.active? ? "Active" : "Inactive" %>
          </td>

          <td>
            <%= link_to "Edit",
                        edit_supplier_path(supplier) %>

            <%= button_to(
                  supplier.active? ? "Disable" : "Enable",
                  toggle_status_supplier_path(supplier),
                  method: :patch
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No suppliers found.</p>
<% end %>