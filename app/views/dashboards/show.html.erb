<% content_for :title, "#{@organization.name} Dashboard" %>

<div class="dashboard-page">
  <header class="dashboard-header">
    <div>
      <span class="eyebrow">Organization dashboard</span>
      <h1><%= @organization.name %></h1>

      <p>
        Current branch:
        <strong><%= @branch&.name || "Not selected" %></strong>
      </p>
    </div>

    <div class="dashboard-user">
      <strong><%= current_user.name %></strong>
      <small><%= @membership.role.titleize %></small>
    </div>
  </header>

  <section class="summary-grid">
    <article class="summary-card">
      <span>Branches</span>
      <strong><%= @branches_count %></strong>
      <small>Active business locations</small>
    </article>

    <article class="summary-card">
      <span>Users</span>
      <strong><%= @users_count %></strong>
      <small>Active organization members</small>
    </article>

    <article class="summary-card">
      <span>Your role</span>
      <strong class="summary-word">
        <%= @membership.role.titleize %>
      </strong>
    </article>

    <article class="summary-card">
      <span>System status</span>
      <strong class="summary-word">Setup</strong>
      <small>Phase 4 in progress</small>
    </article>
  </section>



  <% if current_membership&.organization_admin? %>
  <section class="dashboard-panel">
    <div class="panel-heading">
      <div>
        <h2>Quick actions</h2>
        <p>Manage the organization foundation.</p>
      </div>
    </div>

    <div class="quick-actions-grid">
      <%= link_to edit_settings_organization_path,
                  class: "quick-action-card" do %>
        <strong>Company settings</strong>
        <span>Update business and receipt details</span>
      <% end %>

      <%= link_to branches_path,
                  class: "quick-action-card" do %>
        <strong>Manage branches</strong>
        <span>Create, edit and select locations</span>
      <% end %>

      <%= link_to team_members_path,
                  class: "quick-action-card" do %>
        <strong>Manage team</strong>
        <span>Add users and control access</span>
      <% end %>
    </div>
  </section>
<% end %>


  <% if current_membership.product_setup_management? %>
  <section class="dashboard-panel">
    <div class="panel-heading">
      <div>
        <h2>Product Setup</h2>
        <p>Configure your catalogue, units and taxes.</p>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "Product Categories",
                  product_categories_path,
                  class: "button button--secondary" %>

      <%= link_to "Units",
                  unit_of_measures_path,
                  class: "button button--secondary" %>

      <%= link_to "Tax Rates",
                  tax_rates_path,
                  class: "button button--secondary" %>

      <%= link_to "Items and Services",
                  items_path,
                  class: "button button--primary" %>

      <%= link_to "New Item",
                  new_item_path,
                  class: "button button--secondary" %>
    </div>
  </section>
<% end %>

  <% if current_membership.money_setup_management? %>
    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <h2>Money and Payment Setup</h2>

          <p>
            Configure tills, bank accounts and payment methods.
          </p>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Money Accounts",
                    money_accounts_path,
                    class:
                      "button button--primary" %>

        <%= link_to "New Money Account",
                    new_money_account_path,
                    class:
                      "button button--secondary" %>
        <%= link_to "Payment Methods",
            payment_methods_path,
            class:
              "button button--secondary" %>

        <%= link_to "New Payment Method",
                    new_payment_method_path,
                    class:
                      "button button--secondary" %>
        <%= link_to "Branch Payment Defaults",
                branch_payment_settings_path,
                class: "button button--secondary" %>
        <%= link_to "Money Transfers",
            money_transfers_path,
            class: "button button--secondary" %>

        <%= link_to "New Transfer",
                    new_money_transfer_path,
                    class: "button button--secondary" %>
      </div>
    </section>
  <% end %>


  <section>
    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <h2>Business Records</h2>
          <p>Manage customers and suppliers.</p>
        </div>
      </div>

      <div class="quick-actions-grid">
        <%= link_to customers_path,
                    class: "quick-action-card" do %>
          <strong>Customers</strong>
          <span>View and manage customer records</span>
        <% end %>

        <%= link_to new_customer_path,
                    class: "quick-action-card" do %>
          <strong>New Customer</strong>
          <span>Create a new customer record</span>
        <% end %>

        <% if current_membership.supplier_management? %>
          <%= link_to suppliers_path,
                      class: "quick-action-card" do %>
            <strong>Suppliers</strong>
            <span>View and manage supplier records</span>
          <% end %>

          <%= link_to new_supplier_path,
                      class: "quick-action-card" do %>
            <strong>New Supplier</strong>
            <span>Create a new supplier record</span>
          <% end %>
        <% end %>
      </div>
    </section>

    <% if current_membership.inventory_adjustment_management? %>
    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <h2>Inventory</h2>

          <p>
            Record opening quantities and stock adjustments.
          </p>
          <%= link_to "Stock Transfers",
                stock_transfers_path,
                class: "button button--secondary" %>

           <%= link_to "New Stock Transfer",
                new_stock_transfer_path,
                class: "button button--secondary" %>
            <%= link_to "Stock Balances",
                stock_levels_path,
                class: "button button--primary" %>

            <%= link_to "Low Stock",
                        stock_levels_path(status: "low_stock"),
                        class: "button button--secondary" %>

            <%= link_to "Out of Stock",
                        stock_levels_path(status: "out_of_stock"),
                        class: "button button--secondary" %>

            <%= link_to "Movement History",
                        stock_movements_path,
                        class: "button button--secondary" %>

            <% if current_membership.supplier_management? %>
            <%= link_to "Receive Purchase",
                        new_purchasing_purchase_path,
                        class: "button button--primary" %>
          <% end %>
           <% if current_membership.inventory_adjustment_management? %>
              <%= link_to "Assign Existing Stock Batch",
                          new_inventory_batch_assignment_path %>
          <% end %>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Opening Stock / Adjustment",
                    new_inventory_adjustment_path,
                    class: "button button--primary" %>
      </div>
    </section>
  <% end %>

  <% if current_membership.pos_access? %>
    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <h2>Sales</h2>

          <p>
            Create customer and walk-in sales.
          </p>
        </div>
      </div>

      <div class="form-actions">
        <% if current_membership.pos_access? %>
          <%= link_to "Open Point of Sale",
                      new_pos_sale_path,
                      class: "button button--primary" %>
        <% end %>

        <% if current_membership.sales_view? %>
        <%= link_to "Sales History",
                    sales_path,
                    class: "button button--secondary" %>

        <%= link_to "Outstanding Sales",
                    sales_path(
                      payment_status: "partially_paid"
                    ),
                    class: "button button--secondary" %>

        <%= link_to "Unpaid Sales",
                    sales_path(
                      payment_status: "unpaid"
                    ),
                    class: "button button--secondary" %>
      <% end %>
      </div>
      </div>
    </section>
  <% end %>

  <% if @expiry_summary.present? %>
    <section class="panel">
      <header>
        <h2>Expiry Alerts</h2>

        <%= link_to "View Expiry Report",
                    inventory_batches_path %>
      </header>

      <% if @expiry_summary.expired_batches.positive? %>
        <p>
          <strong>
            <%= @expiry_summary.expired_batches %>
            expired batches must be removed from sale.
          </strong>
        </p>
      <% end %>

      <% if @expiry_summary
              .expiring_within_7_days
              .positive? %>
        <p>
          <strong>
            <%= @expiry_summary
                  .expiring_within_7_days %>
            batches expire within 7 days.
          </strong>

          <%= link_to "Review now",
                      inventory_batches_path(
                        status: "7"
                      ) %>
        </p>
      <% end %>

      <dl class="details-list">
        <div>
          <dt>Expired batches</dt>
          <dd>
            <%= @expiry_summary.expired_batches %>
          </dd>
        </div>

        <div>
          <dt>Within 7 days</dt>
          <dd>
            <%= @expiry_summary
                  .expiring_within_7_days %>
          </dd>
        </div>

        <div>
          <dt>Within 30 days</dt>
          <dd>
            <%= @expiry_summary
                  .expiring_within_30_days %>
          </dd>
        </div>

        <div>
          <dt>Within 90 days</dt>
          <dd>
            <%= @expiry_summary
                  .expiring_within_90_days %>
          </dd>
        </div>
      </dl>
    </section>
  <% end %>

  <section class="dashboard-panel">
    <h2>Setup progress</h2>

    <div class="setup-list">
      <div class="setup-item complete">
        <span class="setup-check">✓</span>
        <div>
          <strong>Owner account created</strong>
          <p><%= current_user.email %></p>
        </div>
      </div>

      <div class="setup-item complete">
        <span class="setup-check">✓</span>
        <div>
          <strong>Organization created</strong>
          <p><%= @organization.name %></p>
        </div>
      </div>

      <div class="setup-item complete">
        <span class="setup-check">✓</span>
        <div>
          <strong>Main branch created</strong>
          <p><%= @branch&.name || "Missing" %></p>
        </div>
      </div>
    </div>
  </section>
</div>

